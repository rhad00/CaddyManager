{
  "name": "backend",
  "version": "1.0.0",
  "description": "This directory contains the backend API server for CaddyManager, providing the core functionality for managing Caddy Server configurations, user authentication, and proxy management.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "jest",
    "test:unit": "jest --config jest.unit.config.js",
    "test:integration": "jest --config jest.integration.config.js",
    "test:smoke": "jest tests/integration/allFeatures.smoke.test.js tests/integration/routeModules.smoke.test.js",
    "test:regression": "jest tests/integration/keys.routes.regression.test.js tests/integration/proxies.routes.real.test.js tests/unit/cloudflarePolicy.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "test:ci": "jest --config jest.ci.config.js --forceExit",
    "test:coverage": "jest --coverage --coverageReporters=text-summary --coverageReporters=json-summary",
    "test:watch": "jest --watch",
    "audit:check": "npm audit --audit-level=high",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "nodemon --watch src --ext js,ts,json --exec \"npm run build && node --enable-source-maps dist/index.js\"",
    "start": "npm run build && node --enable-source-maps dist/index.js",
    "start:cluster": "npm run build && CLUSTER_MODE=true node --enable-source-maps dist/cluster.js",
    "test:contract": "jest --config jest.contract.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dockerode": "^5.0.1",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "simple-git": "^4.0.2",
    "speakeasy": "^2.0.0",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
