{
  "name": "backend",
  "version": "1.0.0",
  "description": "This directory contains the backend API server for CaddyManager, providing the core functionality for managing Caddy Server configurations, user authentication, and proxy management.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "jest",
    "test:unit": "jest --config jest.unit.config.js",
    "test:integration": "jest --config jest.integration.config.js",
    "test:smoke": "jest tests/integration/allFeatures.smoke.test.js tests/integration/routeModules.smoke.test.js",
    "test:regression": "jest tests/integration/keys.routes.regression.test.js tests/integration/proxies.routes.real.test.js tests/unit/cloudflarePolicy.test.js",
    "test:coverage": "jest --coverage --coverageReporters=text-summary --coverageReporters=json-summary",
    "test:watch": "jest --watch",
    "audit:check": "npm audit --audit-level=high",
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "start:cluster": "CLUSTER_MODE=true node src/cluster.js",
    "test:contract": "jest --config jest.contract.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dockerode": "^4.0.2",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "simple-git": "^3.36.0",
    "speakeasy": "^2.0.0",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
