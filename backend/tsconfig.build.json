  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "removeComments": false,
    "declaration": false
  },
  "include": ["src/**/*.js", "src/**/*.ts"],
  "exclude": ["node_modules", "coverage", "dist"]
}
