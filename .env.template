# CaddyManager Configuration

# Caddy Version
CADDY_VERSION=2.10.2

# Cloudflare Configuration
# Required for DNS challenges with Cloudflare
CF_API_TOKEN=

# Backend Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database Configuration
DB_TYPE=sqlite
SQLITE_PATH=/app/data/caddymanager.db

# Authentication
# Generate each secret with: openssl rand -hex 32  (never use a placeholder)
JWT_SECRET=
JWT_EXPIRES_IN=24h
CSRF_SECRET=
GIT_SECRET_KEY=
# Encrypts 2FA secrets, certificate private keys and Git credentials stored in the database
ENCRYPTION_KEY=

# Browsers drop Secure cookies on plain HTTP (except on localhost). Leave false to log in over
# http://server-ip:8080; set true once the UI is served over HTTPS.
COOKIE_SECURE=false

# Admin User (created on first run)
ADMIN_EMAIL=admin@caddymanager.local
# Leave ADMIN_PASSWORD unset to get a random one, printed once in the backend log
# ADMIN_PASSWORD=

# Caddy API URL (internal docker network)
CADDY_API_URL=http://caddy:2019

# Frontend Configuration
VITE_API_URL=/api

# --- Client address behind another proxy (rate limits, IP filters, X-Forwarded-For) ---------
# By default only loopback is trusted, so behind Cloudflare or another proxy every visitor looks
# like that proxy. Pick ONE of these (uncomment) so Caddy sees the real visitor:
#
# A proxy on the same Docker/private network (nginx, Traefik, another Caddy):
# CADDY_TRUSTED_PROXIES=private_ranges
#
# Cloudflare (ranges from https://www.cloudflare.com/ips-v4 and /ips-v6, checked 2026-10-15;
# re-check them now and then):
# CADDY_TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
# CADDY_CLIENT_IP_HEADERS=CF-Connecting-IP X-Forwarded-For
