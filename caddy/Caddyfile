# Global options
{
	# Admin API endpoint (only accessible from internal network)
	admin 0.0.0.0:2019
	auto_https disable_redirects
	metrics {
		per_host
	}
	
	# Use custom storage for certificates and other data
	storage file_system {
		root /data
	}

	# Clients behind a front proxy (Cloudflare, another Caddy): list its address ranges in
	# CADDY_TRUSTED_PROXIES (space separated CIDRs) so rate limits, IP filters and
	# X-Forwarded-For use the real visitor. Only loopback is trusted by default.
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/32}
		# right-to-left: the entry added by the nearest trusted proxy wins, not one the client wrote
		trusted_proxies_strict
		client_ip_headers {$CADDY_CLIENT_IP_HEADERS:X-Forwarded-For}
	}
}

:80 {
    handle {
        respond "No routes configured yet" 503
    }
}

:443 {
    handle {
        respond "No routes configured yet (HTTPS)" 503
    }
}