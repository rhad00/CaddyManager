# CaddyManager production settings for docker-compose.prod.yml
#
#   cp .env.prod.example .env.prod
#   # fill in the values, then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# Keep .env.prod private (it is in .gitignore) and never commit real values.

# --- Required ---------------------------------------------------------------

# PostgreSQL password
DB_PASSWORD=

# Signs login tokens. openssl rand -hex 32
JWT_SECRET=

# Signs CSRF tokens; the backend refuses to start in production without it.
# openssl rand -hex 32
CSRF_SECRET=

# Encrypts the access tokens of Git repositories; the Git service refuses to start
# in production without it, and tokens are unreadable if it changes.
# openssl rand -hex 32
GIT_SECRET_KEY=

# --- Recommended ------------------------------------------------------------

# Encrypts other stored credentials (64 hex characters = 32 bytes). When empty they are
# stored unencrypted. Cannot be changed later without re-entering them.
# openssl rand -hex 32
ENCRYPTION_KEY=

# Cloudflare API token for DNS-challenge certificates. Leave empty if you do not use
# Cloudflare (then use the HTTP-01 "acme" certificate type).
CF_API_TOKEN=

# --- Optional ---------------------------------------------------------------

# Browser origins allowed to call the API cross-origin, comma separated. Empty (the
# default) allows none, which is right when the UI is served from the same origin.
CORS_ORIGINS=

DB_NAME=caddymanager
DB_USER=caddyuser
JWT_EXPIRES_IN=24h
LOG_LEVEL=info

# --- Client address behind another proxy (rate limits, IP filters, X-Forwarded-For) ---------
# By default only loopback is trusted, so behind Cloudflare or another proxy every visitor looks
# like that proxy. Pick ONE of these (uncomment) so Caddy sees the real visitor:
#
# A proxy on the same Docker/private network (nginx, Traefik, another Caddy):
# CADDY_TRUSTED_PROXIES=private_ranges
#
# Cloudflare (ranges from https://www.cloudflare.com/ips-v4 and /ips-v6, checked 2026-10-15;
# re-check them now and then):
# CADDY_TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
# CADDY_CLIENT_IP_HEADERS=CF-Connecting-IP X-Forwarded-For
